{
  "name": "linkup-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node -r dotenv/config node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "npm run build && npx prisma migrate deploy && node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
